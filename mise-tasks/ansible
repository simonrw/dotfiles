#!/usr/bin/env bash
#MISE description="Provision system with ansible"

set -euo pipefail

if [[ "$OSTYPE" == darwin* ]]; then
    echo "Only works for ubuntu" >&2
    exit 0
fi

task_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v ansible-playbook >/dev/null; then
    bash "$task_dir/prepare"
fi

ansible-galaxy role install -r "$task_dir/../ansible/requirements.yml"

exec ansible-playbook --ask-become-pass "$task_dir/../ansible/main.yml" "$@"

