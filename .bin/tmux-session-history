#!/usr/bin/env bash

set -euo pipefail

FZF_THEME=light
if is-dark-theme; then
  FZF_THEME=dark
fi

if [[ -z "${SESSION_BACKEND:-}" ]]; then
  if [[ "${HERDR_ENV:-}" == "1" ]]; then
    SESSION_BACKEND="herdr"
  elif [[ -n "${TMUX:-}" ]]; then
    SESSION_BACKEND="tmux"
  elif [[ -n "${REX_SESSION:-}" ]]; then
    SESSION_BACKEND="rex"
  else
    SESSION_BACKEND="herdr"
  fi
fi

case "${SESSION_BACKEND}" in
  herdr)
    HERDR="${HERDR_BIN_PATH:-herdr}"
    HISTORY="$(cd "$(dirname "$(readlink -f "$0")")/../.config/herdr/plugins/last-focus" && pwd)/last-focus"
    WORKSPACE_ID="$(
      "$HISTORY" list-workspaces \
        | jq -r '.result.workspaces[] | [.label, .workspace_id] | @tsv' \
        | fzf --color="${FZF_THEME}" --layout=default --no-sort --delimiter=$'\t' --with-nth=1 \
        | cut -f2
    )" || exit 0
    [[ -n "${WORKSPACE_ID}" ]] || exit 0

    "$HERDR" workspace focus "${WORKSPACE_ID}" >/dev/null
    if [[ "${HERDR_ENV:-}" != "1" ]]; then
      exec "$HERDR"
    fi
    ;;
  rex)
    # Rex probes the terminal on startup; finish before fzf reads its replies.
    SESSIONS="$(rex ls --json)"
    SESSION_ID="$(
      jq -r '.sessions[] | [.label, .session_id] | @tsv' <<< "$SESSIONS" \
        | fzf --color="${FZF_THEME}" --layout=default --no-sort --delimiter=$'\t' --with-nth=1 \
        | cut -f2
    )" || exit 0
    [[ -n "${SESSION_ID}" ]] || exit 0

    if [[ -n "${REX_SESSION:-}" ]]; then
      exec rex do session.select "session_id=$SESSION_ID"
    else
      exec rex attach "$SESSION_ID"
    fi
    ;;
  tmux)
    SESSION_NAME="$(tmux ls -F "#{session_activity} #S" | sort -n -r | awk '{print $2}' | fzf --color="${FZF_THEME}" --layout=default --no-sort)" || exit 0
    [[ -n "${SESSION_NAME}" ]] || exit 0
    tat "${SESSION_NAME}"
    ;;
  *)
    printf 'Unknown session history backend: %s\n' "${SESSION_BACKEND}" >&2
    exit 1
    ;;
esac
