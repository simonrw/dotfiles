#!/usr/bin/env python3


import subprocess as sp
from pathlib import Path
import argparse
import json
import os
import logging


logging.basicConfig(level=logging.WARNING)
logger = logging.getLogger("tnew")


def list_sessions():
    try:
        sessions = run_tmux("ls", "-F", "#S")
    except sp.CalledProcessError:
        return []

    yield from sessions.split()


def session_exists(session_name):
    logger.debug(f"looking for session {session_name}")
    for session in list_sessions():
        if session_name == session:
            logger.debug(f"found session {session_name}")
            return True
    logger.debug(f"cannot find session {session_name}")
    return False


def attach_to_session(session_name, exec):
    logger.debug(f"attaching to session {session_name}")
    run_tmux("attach", "-t", session_name, exec=exec)


def create_session(session_name):
    logger.debug(f"creating new session {session_name}")
    run_tmux("new-session", "-d", "-s", session_name)


def switch_client(session_name, exec):
    logger.debug(f"switching to session {session_name}")
    run_tmux("switch-client", "-t", session_name, exec=exec)


def run_tmux(*args, exec=False):
    cmd = [
        "tmux",
    ] + list(args)
    logger.debug(f"running command: {cmd}")

    if exec:
        os.execvp(cmd[0], cmd)
    else:
        proc = sp.run(cmd, check=True, stdout=sp.PIPE)
        return proc.stdout.decode("utf8")


def session_backend():
    if os.getenv("HERDR_ENV") == "1":
        return "herdr"
    if os.getenv("TMUX"):
        return "tmux"
    if os.getenv("REX_SESSION"):
        return "rex"
    return os.getenv("SESSION_BACKEND", "herdr")


def create_herdr_workspace(path):
    label = sp.check_output(["mux-session-name", "--backend", "herdr", str(path)], text=True).rstrip("\n")
    cmd = ["herdr", "workspace", "create", "--cwd", str(path), "--focus", "--label", label]
    logger.debug(f"running command: {cmd}")
    sp.run(cmd, check=True)

    if os.getenv("HERDR_ENV") != "1":
        os.execvp("herdr", ["herdr"])


def create_rex_session(path):
    label = sp.check_output(["mux-session-name", "--backend", "rex", str(path)], text=True).rstrip("\n")
    sessions = json.loads(sp.check_output(["rex", "ls", "--json"], text=True))["sessions"]
    session_id = next(
        (session["session_id"] for session in sessions if session["label"] == label),
        None,
    )
    if session_id is None:
        session = json.loads(
            sp.check_output(["rex", "new", label, "--cwd", str(path), "--json"], text=True)
        )
        session_id = session["session_id"]
    if os.getenv("REX_SESSION"):
        cmd = ["rex", "do", "session.select", f"session_id={session_id}"]
    else:
        cmd = ["rex", "attach", session_id]
    os.execvp("rex", cmd)


parser = argparse.ArgumentParser()
parser.add_argument("-p", "--path", type=Path, default=Path.cwd())
parser.add_argument("-v", "--verbose", action="count", default=0)
args = parser.parse_args()

if args.verbose == 1:
    logger.setLevel(logging.INFO)
elif args.verbose > 1:
    logger.setLevel(logging.DEBUG)

args.path.mkdir(exist_ok=True, parents=True)

backend = session_backend()

if backend == "herdr":
    create_herdr_workspace(args.path.resolve())
elif backend == "rex":
    create_rex_session(args.path.resolve())
elif backend == "tmux":
    tmux_name = sp.check_output(["mux-session-name", "--backend", "tmux", str(args.path)], text=True).rstrip("\n")

    if os.getenv("TMUX"):
        logger.debug("in tmux session")
        if session_exists(tmux_name):
            switch_client(tmux_name, exec=True)
        else:
            create_session(tmux_name)
            switch_client(tmux_name, exec=True)
    else:
        logger.debug("not in tmux session")
        if session_exists(tmux_name):
            attach_to_session(tmux_name, exec=True)
        else:
            create_session(tmux_name)
            attach_to_session(tmux_name, exec=True)
else:
    parser.error(f"unknown session backend: {backend}")
