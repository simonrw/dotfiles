#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'Usage: %s <pre-start|post-remove> <worktree-path>\n' "${0##*/}" >&2
    exit 2
}

ACTION="${1:-}"
WORKTREE_PATH="${2:-}"

[[ $# -eq 2 && -n "$WORKTREE_PATH" ]] || usage

LABEL="$(mux-session-name "$WORKTREE_PATH")"

case "${SESSION_BACKEND:-}" in
    herdr)
        case "$ACTION" in
            pre-start)
                herdr workspace create --cwd "$WORKTREE_PATH" --label "$LABEL" --focus
                ;;
            post-remove)
                herdr workspace list \
                    | jq -r --arg label "$LABEL" '.result.workspaces[] | select(.label == $label) | .workspace_id' \
                    | while IFS= read -r workspace_id; do
                        herdr workspace close "$workspace_id"
                    done
                ;;
            *)
                usage
                ;;
        esac
        ;;
    rex)
        case "$ACTION" in
            pre-start)
                SESSION_ID="$(rex ls --json | jq -r --arg label "$LABEL" 'first(.sessions[] | select(.label == $label) | .session_id) // empty')"
                if [[ -z "$SESSION_ID" ]]; then
                    SESSION_ID="$(rex new "$LABEL" --cwd "$WORKTREE_PATH" --json | jq -r '.session_id')"
                fi
                if [[ -n "${REX_SESSION:-}" ]]; then
                    rex do session.select "session_id=$SESSION_ID"
                else
                    rex attach "$SESSION_ID"
                fi
                ;;
            post-remove)
                rex ls --json \
                    | jq -r --arg label "$LABEL" '.sessions[] | select(.label == $label) | .session_id' \
                    | while IFS= read -r session_id; do
                        rex kill "$session_id"
                    done
                ;;
            *)
                usage
                ;;
        esac
        ;;
    tmux)
        case "$ACTION" in
            pre-start)
                tmux new-session -d -s "$LABEL" -c "$WORKTREE_PATH" 2>/dev/null || true
                tmux switch-client -t "$LABEL"
                ;;
            post-remove)
                tmux kill-session -t "$LABEL" 2>/dev/null || true
                ;;
            *)
                usage
                ;;
        esac
        ;;
    *)
        printf 'Unknown session backend: %s\n' "${SESSION_BACKEND:-}" >&2
        exit 1
        ;;
esac
