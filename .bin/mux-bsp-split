#!/usr/bin/env python3

import argparse
import json
import os
import re
import subprocess


def is_wide(width, height):
    """Terminal cells are roughly twice as tall as they are wide."""
    return width > height * 2


def tmux_direction(layout, pane_id):
    """Choose a split from the pane's dimensions in terminal cells."""
    for match in re.finditer(r"(\d+)x(\d+),\d+,\d+,(\d+)", layout):
        width, height, target_id = match.groups()
        if target_id == pane_id.lstrip("%"):
            return "-h" if is_wide(int(width), int(height)) else "-v"
    raise ValueError(f"Pane {pane_id} is missing from the layout")


def herdr_direction(layout, pane_id):
    """Choose a split from the pane's dimensions in terminal cells."""
    pane = next((p["rect"] for p in layout["panes"] if p["pane_id"] == pane_id), None)
    if pane is None:
        raise ValueError(f"Pane {pane_id} is missing from the layout")
    return "right" if is_wide(pane["width"], pane["height"]) else "down"


def main():
    parser = argparse.ArgumentParser(
        description="Split a tmux or Herdr pane 50/50 along its longer visual dimension."
    )
    parser.add_argument(
        "--backend",
        choices=("tmux", "herdr"),
        default="tmux"
        if os.getenv("TMUX")
        else "herdr"
        if os.getenv("HERDR_ENV") == "1"
        else None,
    )
    parser.add_argument("-p", "--print-only", action="store_true", default=False)
    parser.add_argument("pane_id", nargs="?")
    args = parser.parse_args()
    if args.backend == "tmux":
        pane_id = args.pane_id or os.getenv("TMUX_PANE")
        if not pane_id:
            parser.error("a tmux pane ID is required")
        layout = subprocess.check_output(
            ["tmux", "display-message", "-p", "-t", pane_id, "#{window_layout}"],
            text=True,
        )
        direction = tmux_direction(layout, pane_id)
        if args.print_only:
            print(direction)
            exit()
        command = [
            "tmux",
            "split-window",
            "-t",
            pane_id,
            direction,
            "-l",
            "50%",
            "-c",
            "#{pane_current_path}",
        ]
    elif args.backend == "herdr":
        herdr = os.getenv("HERDR_BIN_PATH") or "herdr"
        target = ["--pane", args.pane_id] if args.pane_id else ["--current"]
        pane = json.loads(
            subprocess.check_output(
                [herdr, "pane", "current", *target],
                text=True,
            )
        )["result"]["pane"]
        pane_id = pane["pane_id"]
        layout = json.loads(
            subprocess.check_output(
                [herdr, "pane", "layout", "--pane", pane_id],
                text=True,
            )
        )["result"]["layout"]
        direction = herdr_direction(layout, pane_id)
        if args.print_only:
            print(direction)
            exit()
        command = [
            herdr,
            "pane",
            "split",
            "--pane",
            pane_id,
            "--direction",
            direction,
            "--ratio",
            "0.5",
            "--focus",
        ]
        if cwd := pane.get("foreground_cwd") or pane.get("cwd"):
            command += ["--cwd", cwd]
    else:
        parser.error("run inside tmux or Herdr, or specify --backend and a pane ID")
    subprocess.run(command, check=True)


if __name__ == "__main__":
    main()
