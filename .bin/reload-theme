#!/usr/bin/env python3

import argparse
import errno
import fcntl
import os
import signal
import stat
import subprocess as sp
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from configparser import ConfigParser
from enum import Enum, auto
from pathlib import Path
from typing import Protocol


class Theme(Enum):
    dark = auto()
    light = auto()


class ThemeSwitcher(Protocol):
    def __call__(self, theme: Theme) -> None: ...


def current_theme() -> Theme:
    # MacOS: use 'defaults'
    if sys.platform == "darwin":
        try:
            output = sp.check_output(
                ["defaults", "read", "NSGlobalDomain", "AppleInterfaceStyle"],
                stderr=sp.DEVNULL,
            )
            if output.decode().strip().lower() == "dark":
                return Theme.dark
        except sp.CalledProcessError:
            # If the key doesn't exist or light mode is set, treat as light
            return Theme.light
        return Theme.light

    # Ubuntu with GNOME: check gsettings color-scheme
    if sys.platform.startswith("linux"):
        try:
            output = sp.check_output(
                [
                    "gsettings",
                    "get",
                    "org.gnome.desktop.interface",
                    "color-scheme",
                ]
            )
            val = output.decode().strip().lower().replace("'", "")
            # Possible values: 'default', 'prefer-dark', 'prefer-light'
            if "dark" in val:
                return Theme.dark
            if "light" in val:
                return Theme.light
        except (sp.CalledProcessError, FileNotFoundError):
            # gsettings not present, or schema not available
            pass

        # Fallback: try gtk-theme, which may end in '-dark', commonly
        try:
            output = sp.check_output(
                [
                    "gsettings",
                    "get",
                    "org.gnome.desktop.interface",
                    "gtk-theme",
                ]
            )
            val = output.decode().strip().lower().replace("'", "")
            if val.endswith("-dark") or "dark" in val:
                return Theme.dark
        except (sp.CalledProcessError, FileNotFoundError):
            pass
        return Theme.light

    # Fallback to dark by default
    return Theme.dark


def restart_agent_sidebars() -> None:
    """Respawn open agent-sidebar panes so they re-read @sidebar_color_* options.

    The sidebar reads its palette only at startup, so a theme change requires
    restarting the binary. Only currently-open sidebar panes are touched.
    """
    try:
        sidebar_bin = (
            sp.check_output(["tmux", "show-option", "-gqv", "@agent_sidebar_bin"])
            .decode()
            .strip()
        )
        if not sidebar_bin:
            return
        panes = sp.check_output(
            ["tmux", "list-panes", "-a", "-F", "#{pane_id} #{@pane_role}"]
        ).decode()
    except sp.CalledProcessError:
        return

    for line in panes.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == "sidebar":
            sp.call(["tmux", "respawn-pane", "-k", "-t", parts[0], sidebar_bin])


def reload_tmux(theme: Theme):
    # A LaunchAgent also runs when no tmux server is running.
    try:
        if sp.call(["tmux", "has-session"], stderr=sp.DEVNULL) != 0:
            return
    except FileNotFoundError:
        return
    sp.check_call(
        ["tmux", "source-file", str(Path.home() / ".config" / "tmux" / "tmux.conf")]
    )
    restart_agent_sidebars()


def reload_shells(theme: Theme):
    """Notify opted-in shells in every session on this tmux server.

    A FIFO belongs to the shell that opened it, not whichever program happens
    to occupy the pane now. Stale registrations cannot send signals or input to
    another process. Busy shells consume their request at the next prompt.
    """
    try:
        pipes = sp.check_output(
            ["tmux", "list-panes", "-a", "-F", "#{@theme_reload_fifo}"],
            text=True,
            stderr=sp.DEVNULL,
        )
    except (sp.CalledProcessError, FileNotFoundError):
        return

    for path in set(pipes.splitlines()) - {""}:
        try:
            info = os.lstat(path)
            if not stat.S_ISFIFO(info.st_mode) or info.st_uid != os.getuid():
                continue
            fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
            try:
                os.write(fd, b"reload\n")
            finally:
                os.close(fd)
        except OSError as error:
            # Closed shell, stale registration, or an already-full queue.
            if error.errno not in (
                errno.ENOENT,
                errno.ENXIO,
                errno.EPIPE,
                errno.EAGAIN,
            ):
                raise


def signal_editor_to_reload(*process_names: str):
    for process_name in process_names:
        try:
            raw_output = sp.check_output(
                ["pgrep", "-u", str(os.getuid()), "-x", process_name]
            )
        except sp.CalledProcessError:
            continue
        for pid in raw_output.splitlines():
            try:
                os.kill(int(pid), signal.SIGUSR1)
            except ProcessLookupError:
                pass


def reload_helix(theme: Theme):
    theme_file = Path.home() / ".config" / "helix" / "themes" / "adaptive.toml"
    chosen_theme = "catppuccin_macchiato"
    if theme == Theme.light:
        chosen_theme = "catppuccin_latte"

    with theme_file.open("w") as outfile:
        print(f"inherits = '{chosen_theme}'", file=outfile)

    signal_editor_to_reload("hx")


def reload_neovim(theme: Theme):
    signal_editor_to_reload("nvim")


def reload_git(theme: Theme):
    theme_file = Path.home() / ".config" / "git" / "theme.conf"
    config = ConfigParser()
    if theme == Theme.light:
        syntax_theme = "GitHub"
        dark = "false"
        light = "true"
    else:
        syntax_theme = "Catppuccin Macchiato"
        dark = "true"
        light = "false"

    config["delta"] = {
        "diff-so-fancy": "false" if theme == Theme.light else "true",
        "syntax-theme": syntax_theme,
        "dark": dark,
        "light": light,
        "line-numbers": "false",
        "side-by-side": "false",
    }
    with theme_file.open("w") as outfile:
        config.write(outfile)


def reload_gh_dash(theme: Theme):
    config_path = Path.home() / ".config" / "gh-dash"
    config_file = config_path / "config.yml"
    config_base = config_path / "config-base.yml"
    if theme == Theme.light:
        theme_file = config_path / "config-light.yml"
    else:
        theme_file = config_path / "config-dark.yml"

    with config_file.open("w") as outfile:
        with config_base.open("r") as infile:
            outfile.write(infile.read())
        with theme_file.open("r") as infile:
            outfile.write(infile.read())


def main() -> int:
    parser = argparse.ArgumentParser(description="Refresh application and shell themes")
    # dark-notify appends the appearance to its configured command.
    parser.add_argument("theme", nargs="?", choices=["dark", "light"])
    args = parser.parse_args()

    cache = Path.home() / ".cache"
    cache.mkdir(parents=True, exist_ok=True)
    with (cache / "reload-theme.lock").open("w") as lock:
        # Serialize manual and automatic refreshes of the same generated files.
        fcntl.flock(lock, fcntl.LOCK_EX)
        theme = Theme[args.theme] if args.theme else current_theme()
        switchers: list[ThemeSwitcher] = [
            reload_tmux,
            reload_shells,
            reload_helix,
            reload_neovim,
            reload_git,
            reload_gh_dash,
        ]
        failed = False
        with ThreadPoolExecutor() as pool:
            futures = {pool.submit(fn, theme): fn for fn in switchers}
            for future in as_completed(futures):
                try:
                    future.result()
                except (OSError, sp.SubprocessError) as error:
                    print(f"{futures[future].__name__}: {error}", file=sys.stderr)
                    failed = True
        return int(failed)


if __name__ == "__main__":
    sys.exit(main())
