<!DOCTYPE html>
<html lang="$lang$"$if(dir)$ dir="$dir$"$endif$>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$if(title-prefix)$$title-prefix$ – $endif$$pagetitle$</title>
$if(source-path)$
  <meta name="plan-source" content="$source-path$">
$endif$
  <style>
    /* ---- plan.html5 - review console -------------------------------------
       For reading AI agent plans / design docs. The evidence is the hero:
       code blocks and file:line references get chrome and prominence, prose
       is dense and secondary, and a sticky rail with scroll-spy keeps your
       place in a long document. Catppuccin Latte / Mocha, following the
       system theme. Prints light regardless of screen theme.

       Rendered by ~/.bin/render-plan. Metadata (title, status, ...) is
       lifted from the document by ~/.config/pandoc/plan-meta.lua.

       Review comments: select text to attach a comment; comments persist in
       localStorage and "Copy for agent" turns them into a prompt-ready
       markdown block naming the source file, section, and quoted text.

       NB: a bare dollar sign is pandoc template syntax. To use one literally
       in the CSS or JS below, double it ($$) - a stray one fails the parse.
       -------------------------------------------------------------------- */

    :root {
      color-scheme: light dark;
      /* Catppuccin Latte */
      --bg:       #eff1f5;
      --surface:  #e6e9ef;
      --surface2: #dce0e8;
      --overlay:  #ccd0da;
      --border:   #bcc0cc;
      --text:     #4c4f69;
      --subtext:  #6c6f85;
      --muted:    #8c8fa1;
      --blue:     #1e66f5;
      --sky:      #04a5e5;
      --green:    #40a02b;
      --peach:    #fe640b;
      --mauve:    #8839ef;
      --red:      #d20f39;
      --yellow:   #df8e1d;
      --teal:     #179299;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        /* Catppuccin Mocha */
        --bg:       #1e1e2e;
        --surface:  #181825;
        --surface2: #313244;
        --overlay:  #45475a;
        --border:   #45475a;
        --text:     #cdd6f4;
        --subtext:  #a6adc8;
        --muted:    #7f849c;
        --blue:     #89b4fa;
        --sky:      #89dceb;
        --green:    #a6e3a1;
        --peach:    #fab387;
        --mauve:    #cba6f7;
        --red:      #f38ba8;
        --yellow:   #f9e2af;
        --teal:     #94e2d5;
      }
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: ui-sans-serif, -apple-system, "Inter", "Helvetica Neue", sans-serif;
      font-size: 1rem;
      line-height: 1.58;
      -webkit-font-smoothing: antialiased;
    }

    code, pre, .mono {
      font-family: "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
      font-variant-ligatures: none;
      font-feature-settings: "liga" 0, "calt" 0;
    }

    /* ---- document attributes ---- */
    .attributes-toggle {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface2);
      color: var(--text);
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .attributes-toggle:hover { background: var(--overlay); }
    .attributes-toggle:focus-visible, .attributes-close:focus-visible {
      outline: 2px solid var(--blue);
      outline-offset: 3px;
    }
    .attributes-panel {
      position: fixed;
      inset: 4.5rem 1rem auto auto;
      margin: 0;
      width: min(28rem, calc(100vw - 2rem));
      max-height: calc(100dvh - 5.5rem);
      overflow: auto;
      padding: 1.25rem;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 16px 48px #0004;
      font-size: 0.9rem;
    }
    .attributes-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .attributes-heading h2 { margin: 0; font-size: 0.9rem; font-weight: 500; color: var(--subtext); }
    .attributes-close { border: 0; background: transparent; color: var(--subtext); font: inherit; font-size: 1.4rem; cursor: pointer; }
    .attributes-panel dl { margin: 0.75rem 0 0; }
    .attribute-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--border); }
    .attribute-row dt { color: var(--subtext); }
    .attribute-row dd { margin: 0; white-space: pre-wrap; }
    .attribute-row dt, .attribute-row dd { overflow-wrap: anywhere; min-width: 0; }
    .attribute-row dd dl { margin: 0; }
    .attribute-row dd .attribute-row { display: block; padding: 0.4rem 0; }
    .attribute-row dd .attribute-row:first-child { border-top: 0; padding-top: 0; }
    .attribute-row ul { margin: 0; padding-left: 1rem; }
    .attributes-empty { color: var(--muted); }
    @media (prefers-color-scheme: dark) {
      .attributes-panel { background: #22252b; border-color: #30343b; color: #d5d9e0; }
    }

    /* ---- shell ---- */

    .shell {
      display: grid;
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 0;
      max-width: 84rem;
      margin: 0 auto;
      align-items: start;
    }
    @media (max-width: 60rem) {
      .shell { grid-template-columns: 1fr; }
      .rail { position: static !important; height: auto !important; border-right: 0 !important; border-bottom: 1px solid var(--border); }
      nav#TOC { max-height: 14rem; }
    }

    /* ---- left rail ---- */

    .rail {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1.5rem 1.1rem 3rem 1.5rem;
      border-right: 1px solid var(--border);
      background: var(--surface);
      font-size: 0.8rem;
    }

    .rail .doc-kind {
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 0.5rem;
    }
    .rail .rail-title {
      font-size: 0.95rem;
      font-weight: 620;
      line-height: 1.3;
      margin: 0 0 0.85rem;
      color: var(--text);
      text-wrap: balance;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 1.2rem; }
    .chip {
      font-size: 0.63rem;
      letter-spacing: 0.04em;
      padding: 0.16rem 0.44rem;
      border-radius: 4px;
      background: var(--surface2);
      color: var(--subtext);
      border: 1px solid var(--border);
      white-space: nowrap;
    }
    .chip.is-status { color: var(--peach); border-color: color-mix(in oklab, var(--peach) 40%, transparent); }

    .rail-sep {
      border: 0; border-top: 1px solid var(--border);
      margin: 0 0 0.9rem;
    }

    nav#TOC ul { list-style: none; margin: 0; padding: 0; }
    nav#TOC > ul > li > ul { padding-left: 0.75rem; margin: 0.1rem 0 0.35rem; }
    nav#TOC > ul > li > ul > li > ul { display: none; }
    nav#TOC a {
      display: block;
      color: var(--subtext);
      text-decoration: none;
      padding: 0.19rem 0.5rem 0.19rem 0.6rem;
      border-left: 2px solid transparent;
      border-radius: 0 3px 3px 0;
      line-height: 1.4;
      transition: color 90ms, background 90ms;
    }
    nav#TOC > ul > li > ul a { font-size: 0.74rem; color: var(--muted); }
    nav#TOC a:hover { color: var(--text); background: var(--surface2); }
    nav#TOC a.active {
      color: var(--blue);
      border-left-color: var(--blue);
      background: color-mix(in oklab, var(--blue) 10%, transparent);
      font-weight: 550;
    }

    /* ---- main column ---- */

    main {
      padding: 3rem 3rem 8rem;
      max-width: 56rem;
      min-width: 0;
    }
    @media (max-width: 60rem) { main { padding: 2rem 1.25rem 6rem; } }

    main > h1:first-child, .doc-h1 {
      font-size: 1.85rem;
      font-weight: 650;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin: 0 0 2rem;
      text-wrap: balance;
    }

    h2, h3, h4 { scroll-margin-top: 1.5rem; position: relative; text-wrap: balance; }

    h2 {
      font-size: 1.18rem;
      font-weight: 620;
      letter-spacing: -0.01em;
      margin: 3rem 0 0.9rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    h3 { font-size: 0.98rem; font-weight: 620; margin: 2rem 0 0.55rem; color: var(--text); }
    h4 { font-size: 0.87rem; font-weight: 620; margin: 1.5rem 0 0.4rem; color: var(--subtext); }

    /* hover anchor, PR-review style */
    h2 .anchor, h3 .anchor {
      position: absolute; left: -1.15rem; top: 0;
      color: var(--muted); text-decoration: none;
      opacity: 0; transition: opacity 90ms;
      font-weight: 400;
    }
    h2:hover .anchor, h3:hover .anchor { opacity: 1; }
    h2 .anchor:hover, h3 .anchor:hover { color: var(--blue); }

    p { margin: 0 0 0.9rem; }
    a { color: var(--blue); text-decoration-thickness: 1px; text-underline-offset: 2px; }

    ul, ol { margin: 0 0 0.9rem; padding-left: 1.2rem; }
    li { margin-bottom: 0.3rem; }
    li::marker { color: var(--muted); }

    blockquote {
      margin: 1.1rem 0;
      padding: 0.7rem 1rem;
      background: var(--surface);
      border-left: 3px solid var(--yellow);
      border-radius: 0 5px 5px 0;
      color: var(--subtext);
    }
    blockquote p:last-child { margin-bottom: 0; }

    hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }

    /* ---- inline code + file:line chips ---- */

    :not(pre) > code {
      font-size: 0.82em;
      background: var(--surface2);
      border: 1px solid var(--border);
      padding: 0.06em 0.32em;
      border-radius: 4px;
      color: var(--peach);
      word-break: break-word;
    }
    :not(pre) > code.ref {
      color: var(--teal);
      background: color-mix(in oklab, var(--teal) 12%, transparent);
      border-color: color-mix(in oklab, var(--teal) 35%, transparent);
      white-space: nowrap;
    }
    :not(pre) > code.ref .line {
      color: var(--yellow);
      font-weight: 600;
    }

    /* ---- code blocks with a header bar ---- */

    .codeblock {
      margin: 1.2rem 0 1.4rem;
      border: 1px solid var(--border);
      border-radius: 7px;
      overflow: hidden;
      background: var(--surface);
    }
    .codeblock-bar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.3rem 0.5rem 0.3rem 0.75rem;
      background: var(--surface2);
      border-bottom: 1px solid var(--border);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .codeblock-bar .lang { font-weight: 600; }
    .codeblock-bar .spacer { flex: 1; }
    .codeblock-bar button {
      font: inherit;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: transparent;
      color: var(--muted);
      border: 1px solid transparent;
      border-radius: 4px;
      padding: 0.14rem 0.42rem;
      cursor: pointer;
    }
    .codeblock-bar button:hover { color: var(--text); background: var(--overlay); }
    .codeblock-bar button.done { color: var(--green); }

    /* ---- mermaid diagrams ----
       Each diagram is rendered twice by ~/.config/pandoc/mermaid-init.js,
       light and dark, and the pair is switched here. Printing takes the light
       copy whatever the screen theme is, matching the print rules below. */

    figure.diagram {
      margin: 1.4rem 0;
      padding: 0.9rem 0.75rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 7px;
      background: var(--surface);
      overflow: hidden;
    }
    .diagram-svg { overflow-x: auto; text-align: center; }
    .diagram-svg svg { max-width: 100%; height: auto; }
    .diagram-svg.is-dark { display: none; }
    @media (prefers-color-scheme: dark) {
      .diagram-svg.is-light { display: none; }
      .diagram-svg.is-dark { display: block; }
    }
    figure.diagram pre.mermaid {
      border-top: 1px solid var(--border);
      margin-top: 0.6rem;
      color: var(--subtext);
    }
    figure.diagram pre.mermaid[hidden] { display: none; }
    .diagram-bar {
      display: flex;
      justify-content: flex-end;
      gap: 0.35rem;
      padding-top: 0.35rem;
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .diagram-bar button {
      font: inherit;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: transparent;
      color: var(--muted);
      border: 1px solid transparent;
      border-radius: 4px;
      padding: 0.14rem 0.42rem;
      cursor: pointer;
    }
    .diagram-bar button:hover { color: var(--text); background: var(--overlay); }
    .diagram-bar button.done { color: var(--blue); }
    .diagram-error {
      margin: 0 0 0.5rem;
      font-size: 0.78rem;
      color: var(--red);
    }

    pre {
      margin: 0;
      padding: 0.8rem 0.95rem;
      overflow-x: auto;
      font-size: 1rem;
      line-height: 1.62;
      background: transparent;
      color: var(--text);
    }
    pre code { background: none; border: 0; padding: 0; font-size: inherit; color: inherit; }

    pre .kw, pre .cf            { color: var(--mauve); }
    pre .im, pre .pp            { color: var(--mauve); }
    pre .dt, pre .bu            { color: var(--yellow); }
    pre .st, pre .ch, pre .vs, pre .ss { color: var(--green); }
    pre .dv, pre .bn, pre .fl, pre .cn { color: var(--peach); }
    pre .co, pre .cv, pre .an   { color: var(--muted); font-style: italic; }
    pre .fu                     { color: var(--blue); }
    pre .va                     { color: var(--text); }
    pre .op                     { color: var(--sky); }
    pre .at                     { color: var(--teal); }
    pre .al, pre .er            { color: var(--red); }
    pre .wa                     { color: var(--yellow); }

    /* ---- tables ---- */

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 1.2rem 0;
      font-size: 1rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }
    caption { caption-side: top; text-align: left; font-size: 0.72rem; color: var(--muted); margin-bottom: 0.4rem; }
    th {
      text-align: left;
      background: var(--surface2);
      font-weight: 620;
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--subtext);
      padding: 0.45rem 0.7rem;
      border-bottom: 1px solid var(--border);
    }
    td { padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:nth-child(even) { background: color-mix(in oklab, var(--surface) 55%, transparent); }

    .footnotes { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.82rem; color: var(--subtext); }
    .footnotes hr { display: none; }

    /* ---- review comments ---- */

    mark.comment-mark {
      background: color-mix(in oklab, var(--yellow) 24%, transparent);
      color: inherit;
      border-bottom: 1px solid color-mix(in oklab, var(--yellow) 55%, transparent);
      border-radius: 2px;
      cursor: pointer;
      transition: background 90ms;
    }
    mark.comment-mark:hover,
    mark.comment-mark.flash {
      background: color-mix(in oklab, var(--yellow) 45%, transparent);
    }

    .ui-btn {
      font: inherit;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      cursor: pointer;
    }
    .ui-btn:hover { background: var(--overlay); }
    .ui-btn.primary { background: var(--blue); border-color: var(--blue); color: var(--bg); }
    .ui-btn.primary:hover { filter: brightness(1.08); background: var(--blue); }
    .ui-btn.primary.done { background: var(--green); border-color: var(--green); }
    .ui-btn.primary.failed { background: var(--red); border-color: var(--red); }
    .ui-btn.danger { color: var(--red); margin-right: auto; }

    .sel-btn, .comment-popover { position: absolute; z-index: 60; display: none; }

    .sel-btn {
      font: inherit;
      font-size: 0.72rem;
      font-weight: 600;
      background: var(--surface2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.28rem 0.55rem;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    }
    .sel-btn:hover { background: var(--overlay); }

    .comment-popover {
      width: 19rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.6rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }
    .comment-popover .pop-quote {
      font-size: 0.7rem;
      font-style: italic;
      color: var(--subtext);
      border-left: 2px solid var(--yellow);
      padding-left: 0.5rem;
      margin-bottom: 0.5rem;
      max-height: 3.6em;
      overflow: hidden;
    }
    .comment-popover textarea {
      width: 100%;
      resize: vertical;
      font: inherit;
      font-size: 0.8rem;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.45rem 0.55rem;
      margin: 0 0 0.5rem;
    }
    .comment-popover textarea:focus {
      outline: 2px solid color-mix(in oklab, var(--blue) 45%, transparent);
      border-color: var(--blue);
    }
    .pop-row { display: flex; gap: 0.4rem; justify-content: flex-end; }

    .comments-panel {
      position: fixed;
      right: 1.1rem;
      bottom: 1.1rem;
      z-index: 55;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      font-size: 0.8rem;
    }
    .panel-pill {
      font: inherit;
      font-size: 0.75rem;
      font-weight: 600;
      background: var(--surface2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 0.85rem;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    }
    .panel-pill:hover { background: var(--overlay); }
    .panel-drawer {
      display: none;
      flex-direction: column;
      width: 21rem;
      max-height: 55vh;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.28);
    }
    .comments-panel.open .panel-drawer { display: flex; }
    .panel-list {
      list-style: none;
      margin: 0;
      padding: 0.35rem 0;
      overflow-y: auto;
    }
    .panel-list li {
      margin: 0;
      padding: 0.55rem 0.75rem;
      border-bottom: 1px solid var(--border);
    }
    .panel-list li:last-child { border-bottom: 0; }
    .card-head { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.3rem; }
    .chip.is-orphan { color: var(--red); border-color: color-mix(in oklab, var(--red) 40%, transparent); }
    .card-quote { font-size: 0.72rem; font-style: italic; color: var(--subtext); margin-bottom: 0.25rem; }
    .card-text { white-space: pre-wrap; }
    .card-actions { display: flex; gap: 0.6rem; margin-top: 0.35rem; }
    .card-actions button {
      font: inherit;
      font-size: 0.68rem;
      font-weight: 500;
      background: none;
      border: 0;
      padding: 0;
      color: var(--blue);
      cursor: pointer;
    }
    .card-actions button:hover { text-decoration: underline; }
    .card-actions button.danger { color: var(--red); }
    .panel-foot {
      display: flex;
      gap: 0.4rem;
      justify-content: flex-end;
      padding: 0.5rem 0.6rem;
      border-top: 1px solid var(--border);
      background: var(--surface2);
    }

$if(directory-index)$
    /* ---- directory finder ---- */
    .document-finder { margin-top: 1.5rem; }
    .document-finder label {
      display: block;
      margin-bottom: 0.4rem;
      color: var(--subtext);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .document-finder input {
      width: 100%;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
    }
    .document-finder input:focus {
      border-color: var(--blue);
      outline: 2px solid color-mix(in oklab, var(--blue) 35%, transparent);
      outline-offset: 1px;
    }
    .document-finder-status { min-height: 1.25rem; margin: 0.45rem 0; color: var(--muted); font-size: 0.8rem; }
    .document-finder ul { margin-top: 0; }
    .document-finder li.is-selected a {
      border-radius: 4px;
      outline: 2px solid var(--blue);
      outline-offset: 2px;
    }
$endif$

    @media print {
      /* always print light, whatever the screen theme was */
      :root {
        --bg: #fff; --surface: #f7f8fa; --surface2: #eef0f4; --overlay: #e0e3ea;
        --border: #c8ccd6; --text: #2b2d3c; --subtext: #5a5d70; --muted: #85889c;
        --blue: #1e50c0; --sky: #0a7f9c; --green: #2f7d22; --peach: #b8500a;
        --mauve: #6b2fc0; --red: #b00c30; --yellow: #9a6410; --teal: #12727a;
      }
      .rail, .codeblock-bar, .diagram-bar, .attributes-toggle, .attributes-panel { display: none !important; }
      .diagram-svg.is-dark { display: none !important; }
      .diagram-svg.is-light { display: block !important; }
      figure.diagram { break-inside: avoid; }
      .sel-btn, .comment-popover, .comments-panel { display: none !important; }
      mark.comment-mark { background: none; color: inherit; outline: 1px dashed #9a6410; }
      .shell { display: block; }
      main { padding: 0; max-width: none; }
      body { background: #fff; font-size: 10pt; }
      .codeblock, pre, table, li, blockquote { break-inside: avoid; }
      h2, h3 { break-after: avoid; }
    }
  </style>
$for(css)$
  <link rel="stylesheet" href="$css$">
$endfor$
$for(header-includes)$
  $header-includes$
$endfor$
</head>
<body>
$if(document-attributes)$
<button type="button" class="attributes-toggle" popovertarget="document-attributes" aria-label="Show document attributes">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><path d="M11 6h10M11 18h10"/></svg>
  Attributes
</button>
<section id="document-attributes" class="attributes-panel" popover aria-labelledby="attributes-title">
  <div class="attributes-heading">
    <h2 id="attributes-title">Attributes</h2>
    <button type="button" class="attributes-close" popovertarget="document-attributes" popovertargetaction="hide" aria-label="Close attributes">&#215;</button>
  </div>
  $document-attributes$
</section>
$endif$
<div class="shell">

  <aside class="rail">
$if(server-mode)$
    <p><a href="/">All documents</a></p>
$endif$
    <p class="doc-kind">$if(kicker)$$kicker$$else$Plan review$endif$</p>
$if(title)$
    <p class="rail-title">$title$</p>
$endif$
    <div class="chips">
$if(status)$      <span class="chip is-status">$status$</span>
$endif$
$if(date)$      <span class="chip">$date$</span>
$endif$
$if(repo)$      <span class="chip mono">$repo$</span>
$endif$
$if(author)$$for(author)$      <span class="chip">$author$</span>
$endfor$$endif$
    </div>
    <hr class="rail-sep">
$if(toc)$
    <nav id="$idprefix$TOC" role="doc-toc">
$table-of-contents$
    </nav>
$endif$
  </aside>

  <main>
$for(include-before)$
$include-before$
$endfor$
$if(title)$
    <h1 class="doc-h1">$title$</h1>
$endif$
$body$
  </main>
</div>

<script>
(function () {
  // ---- code blocks: language label + copy button -------------------------
  document.querySelectorAll('pre').forEach(function (pre) {
    if (pre.closest('.codeblock')) return;
    if (pre.closest('figure.diagram')) return;  // diagrams get their own chrome
    var code = pre.querySelector('code');
    var lang = '';
    if (code) {
      code.classList.forEach(function (c) {
        if (c !== 'sourceCode' && !lang) lang = c;
      });
    }
    var wrap = document.createElement('div');
    wrap.className = 'codeblock';
    var bar = document.createElement('div');
    bar.className = 'codeblock-bar';
    bar.innerHTML = '<span class="lang"></span><span class="spacer"></span>';
    bar.querySelector('.lang').textContent = lang || 'text';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = 'copy';
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(pre.innerText).then(function () {
        btn.textContent = 'copied';
        btn.classList.add('done');
        setTimeout(function () { btn.textContent = 'copy'; btn.classList.remove('done'); }, 1400);
      });
    });
    bar.appendChild(btn);
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(bar);
    wrap.appendChild(pre);
  });

  // ---- file:line references get chip treatment ---------------------------
  // NB: no trailing regex anchor - a bare dollar sign is pandoc template syntax.
  var REF = /^[\w./~-]+\.(go|ts|tsx|js|py|rs|yaml|yml|json|toml|md|sh|tf|sql|c|h|cpp|java|rb)(:\d+(-\d+)?)?/;
  document.querySelectorAll('main :not(pre) > code').forEach(function (c) {
    var t = c.textContent.trim();
    var m = REF.exec(t);
    if (!m || m[0].length !== t.length) return;
    c.classList.add('ref');
    var i = t.lastIndexOf(':');
    if (i > 0 && /^\d/.test(t.slice(i + 1))) {
      c.textContent = '';
      c.appendChild(document.createTextNode(t.slice(0, i)));
      var s = document.createElement('span');
      s.className = 'line';
      s.textContent = t.slice(i);
      c.appendChild(s);
    }
  });

  // ---- hover anchors -----------------------------------------------------
  document.querySelectorAll('main h2[id], main h3[id]').forEach(function (h) {
    var a = document.createElement('a');
    a.className = 'anchor';
    a.href = '#' + h.id;
    a.textContent = '#';
    a.setAttribute('aria-hidden', 'true');
    h.insertBefore(a, h.firstChild);
  });

  // ---- scroll-spy ---------------------------------------------------------
  var links = Array.prototype.slice.call(document.querySelectorAll('#TOC a[href^="#"]'));
  var byId = {};
  var targets = [];
  links.forEach(function (a) {
    var el = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
    if (el) { byId[el.id] = a; targets.push(el); }
  });

  var current = null;
  function update() {
    var best = null;
    for (var i = 0; i < targets.length; i++) {
      if (targets[i].getBoundingClientRect().top <= 90) best = targets[i];
      else break;
    }
    if (!best && targets.length) best = targets[0];
    if (best && best !== current) {
      current = best;
      links.forEach(function (a) { a.classList.remove('active'); });
      var a = byId[best.id];
      if (a) {
        a.classList.add('active');
        var rail = document.querySelector('.rail');
        var ar = a.getBoundingClientRect(), rr = rail.getBoundingClientRect();
        if (ar.top < rr.top + 40 || ar.bottom > rr.bottom - 40) {
          rail.scrollTop += ar.top - rr.top - rail.clientHeight / 3;
        }
      }
    }
  }
  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { update(); ticking = false; });
  }, { passive: true });
  update();
})();
</script>

$if(directory-index)$
<script>
(function () {
  var finder = document.querySelector('[data-document-index]');
  if (!finder) return;

  var input = finder.querySelector('input[type="search"]');
  var status = finder.querySelector('.document-finder-status');
  var list = finder.querySelector('#document-list');
  var items = Array.prototype.slice.call(list.querySelectorAll('[data-document-path]'));
  var selected = -1;

  items.forEach(function (item, index) {
    item.dataset.documentOrder = index;
    item.querySelector('a').id = 'document-result-' + index;
  });

  function fuzzyScore(value, query) {
    value = value.toLowerCase();
    query = query.toLowerCase();
    if (!query) return 0;
    var score = 0;
    var previous = -1;
    for (var i = 0; i < query.length; i++) {
      var position = value.indexOf(query.charAt(i), previous + 1);
      if (position < 0) return null;
      var boundary = position === 0 || /[\/._-]/.test(value.charAt(position - 1));
      if (previous >= 0) score += (position - previous - 1) * 4;
      else score += position * 2;
      if (boundary) score -= 2;
      if (position === previous + 1) score -= 1;
      previous = position;
    }
    return score + (value.length - query.length) / 100;
  }

  function visibleItems() {
    return items.filter(function (item) { return !item.hidden; });
  }

  function select(index) {
    var visible = visibleItems();
    items.forEach(function (item) { item.classList.remove('is-selected'); });
    if (!visible.length) {
      selected = -1;
      input.removeAttribute('aria-activedescendant');
      return;
    }
    selected = (index + visible.length) % visible.length;
    var link = visible[selected].querySelector('a');
    visible[selected].classList.add('is-selected');
    input.setAttribute('aria-activedescendant', link.id);
  }

  function update() {
    var query = input.value.trim();
    var matches = [];
    items.forEach(function (item) {
      var score = fuzzyScore(item.dataset.documentPath, query);
      item.hidden = score === null;
      if (score !== null) matches.push({ item: item, score: score });
    });
    matches.sort(function (a, b) {
      return a.score - b.score
        || Number(a.item.dataset.documentOrder) - Number(b.item.dataset.documentOrder);
    });
    matches.forEach(function (match) { list.appendChild(match.item); });
    status.textContent = matches.length + ' file' + (matches.length === 1 ? '' : 's');
    select(matches.length ? 0 : -1);
  }

  input.addEventListener('input', update);
  input.addEventListener('keydown', function (event) {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      select(selected + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      select(selected - 1);
    } else if (event.key === 'Enter') {
      var visible = visibleItems();
      if (visible.length) {
        event.preventDefault();
        visible[selected < 0 ? 0 : selected].querySelector('a').click();
      }
    } else if (event.key === 'Escape' && input.value) {
      input.value = '';
      update();
    }
  });
  document.addEventListener('keydown', function (event) {
    var target = event.target;
    var typing = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
    if ((!typing && event.key === '/') || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) {
      event.preventDefault();
      input.focus();
      input.select();
    }
  });
  update();
})();
</script>
$endif$

<script>
(function () {
  /* ---- review comments ---------------------------------------------------
     Select text in the document to attach a comment. Comments persist in
     localStorage (keyed by the source path baked in at render time) and the
     panel's "Copy for agent" button turns them into one markdown block --
     file, section, quote, comment -- ready to paste into an agent prompt.
     Anchoring is quote-based (W3C TextQuoteSelector style): each comment
     stores its exact text plus ~30 chars of context either side, and is
     re-found by string search on load, so comments survive re-renders. */

  var main = document.querySelector('main');
  if (!main) return;

  var srcMeta = document.querySelector('meta[name="plan-source"]');
  var sourcePath = srcMeta ? srcMeta.getAttribute('content') : '';
  var storeKey = 'plan-comments:' + (sourcePath || document.title);
  var CTX = 30;

  var directoryMeta = document.querySelector('meta[name="plan-directory"]');
  var documents = directoryMeta ? JSON.parse(directoryMeta.content) : null;
  var comments = [];
  function readComments(key) {
    try {
      var value = JSON.parse(localStorage.getItem(key) || '[]');
      return Array.isArray(value) ? value : [];
    } catch (e) { return []; }
  }
  function loadComments() {
    comments = [];
    if (documents) {
      documents.forEach(function (doc) {
        readComments('plan-comments:' + doc.source).forEach(function (c) {
          c.document = doc;
          comments.push(c);
        });
      });
    } else {
      comments = readComments(storeKey);
    }
  }
  loadComments();
  function persist() {
    try {
      if (documents) {
        documents.forEach(function (doc) {
          var own = comments.filter(function (c) { return c.document.source === doc.source; });
          localStorage.setItem('plan-comments:' + doc.source, JSON.stringify(own, function (key, value) {
            return key === 'document' ? undefined : value;
          }));
        });
      } else {
        localStorage.setItem(storeKey, JSON.stringify(comments));
      }
    } catch (e) { window.alert('Could not save comments in this browser.'); }
  }
  function newId() {
    return 'c' + Date.now().toString(36) + Math.floor(Math.random() * 1679616).toString(36);
  }
  function excerpt(s, n) {
    s = s.replace(/\s+/g, ' ').trim();
    return s.length > n ? s.slice(0, n) + '…' : s;
  }

  // ---- text index over main's text nodes ---------------------------------
  // idx.text matches Range.toString() over the same content: both are the
  // concatenation of text node data in document order.
  function buildIndex() {
    var nodes = [], offsets = [], text = '';
    var walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, null);
    var n;
    while ((n = walker.nextNode())) {
      nodes.push(n);
      offsets.push(text.length);
      text += n.nodeValue;
    }
    return { nodes: nodes, offsets: offsets, text: text };
  }

  function globalOffset(container, offset) {
    var r = document.createRange();
    r.selectNodeContents(main);
    r.setEnd(container, offset);
    return r.toString().length;
  }

  // Wrap [startG, endG) in <mark> elements, one per intersecting text node --
  // surroundContents would throw on ranges spanning element boundaries.
  function wrapRange(startG, endG, cid) {
    var idx = buildIndex();
    var segs = [];
    for (var i = 0; i < idx.nodes.length; i++) {
      var node = idx.nodes[i];
      var a = idx.offsets[i], b = a + node.nodeValue.length;
      if (b <= startG || a >= endG) continue;
      segs.push({
        node: node,
        s: Math.max(0, startG - a),
        e: Math.min(node.nodeValue.length, endG - a)
      });
    }
    segs.forEach(function (seg) {
      var node = seg.node;
      if (!node.nodeValue.slice(seg.s, seg.e).trim()) return;
      if (seg.e < node.nodeValue.length) node.splitText(seg.e);
      var target = seg.s > 0 ? node.splitText(seg.s) : node;
      var mark = document.createElement('mark');
      mark.className = 'comment-mark';
      mark.setAttribute('data-cid', cid);
      target.parentNode.insertBefore(mark, target);
      mark.appendChild(target);
    });
  }

  function unwrap(cid) {
    var marks = main.querySelectorAll('mark.comment-mark[data-cid="' + cid + '"]');
    Array.prototype.forEach.call(marks, function (m) {
      var p = m.parentNode;
      while (m.firstChild) p.insertBefore(m.firstChild, m);
      p.removeChild(m);
      p.normalize();
    });
  }

  function sectionFor(node) {
    var el = node.nodeType === 1 ? node : node.parentElement;
    if (!el) return { id: '', title: '' };
    var heads = main.querySelectorAll('h2[id], h3[id]');
    var best = null;
    for (var i = 0; i < heads.length; i++) {
      if (heads[i].compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING) best = heads[i];
    }
    if (!best) return { id: '', title: '' };
    // strip the injected hover-anchor "#" from the heading text
    return { id: best.id, title: best.textContent.replace(/^#\s*/, '').trim() };
  }

  // Last-resort matcher: whitespace-normalized search, mapping the hit back
  // to original offsets. Rescues comments when a re-render moved soft wraps.
  function normSearch(text, quote) {
    var norm = '', map = [];
    for (var i = 0; i < text.length; i++) {
      var ch = text.charAt(i);
      if (/\s/.test(ch)) {
        if (norm && norm.charAt(norm.length - 1) !== ' ') { norm += ' '; map.push(i); }
      } else {
        norm += ch;
        map.push(i);
      }
    }
    var nq = quote.replace(/\s+/g, ' ').trim();
    if (!nq) return null;
    var j = norm.indexOf(nq);
    if (j < 0) return null;
    return { start: map[j], end: map[j + nq.length - 1] + 1 };
  }

  function anchorComment(c) {
    var idx = buildIndex();
    var start = -1, end = -1;
    if (c.prefix || c.suffix) {
      var j = idx.text.indexOf(c.prefix + c.quote + c.suffix);
      if (j >= 0) start = j + c.prefix.length;
    }
    if (start < 0) start = idx.text.indexOf(c.quote);
    if (start >= 0) {
      end = start + c.quote.length;
    } else {
      var hit = normSearch(idx.text, c.quote);
      if (hit) { start = hit.start; end = hit.end; }
    }
    c.anchored = start >= 0;
    if (c.anchored) wrapRange(start, end, c.id);
  }

  // ---- floating UI: selection button + popover ---------------------------
  function mkBtn(label, cls) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'ui-btn' + (cls ? ' ' + cls : '');
    b.textContent = label;
    return b;
  }
  function placeAt(el, x, y) {
    el.style.display = 'block';
    var maxX = window.scrollX + document.documentElement.clientWidth - el.offsetWidth - 8;
    el.style.left = Math.max(8, Math.min(x, maxX)) + 'px';
    el.style.top = y + 'px';
  }

  var selBtn = document.createElement('button');
  selBtn.type = 'button';
  selBtn.className = 'sel-btn';
  selBtn.textContent = '💬 comment';
  document.body.appendChild(selBtn);

  var pop = document.createElement('div');
  pop.className = 'comment-popover';
  var popQuote = document.createElement('div');
  popQuote.className = 'pop-quote';
  var ta = document.createElement('textarea');
  ta.rows = 3;
  ta.placeholder = 'Leave a comment… (⌘⏎ to save)';
  var popRow = document.createElement('div');
  popRow.className = 'pop-row';
  var btnDelete = mkBtn('Delete', 'danger');
  var btnCancel = mkBtn('Cancel');
  var btnSave = mkBtn('Save', 'primary');
  popRow.appendChild(btnDelete);
  popRow.appendChild(btnCancel);
  popRow.appendChild(btnSave);
  pop.appendChild(popQuote);
  pop.appendChild(ta);
  pop.appendChild(popRow);
  document.body.appendChild(pop);

  var editing = null;      // {mode:'create', range} | {mode:'edit', comment}
  var pendingRange = null; // captured on mouseup, before the click clears it

  function openPopover(state, rect) {
    editing = state;
    if (state.mode === 'edit') {
      popQuote.textContent = excerpt(state.comment.quote, 120);
      ta.value = state.comment.text;
      btnDelete.style.display = '';
    } else {
      popQuote.textContent = excerpt(state.range.toString(), 120);
      ta.value = '';
      btnDelete.style.display = 'none';
    }
    placeAt(pop, window.scrollX + rect.left, window.scrollY + rect.bottom + 8);
    ta.focus();
  }
  function closePopover() {
    editing = null;
    pop.style.display = 'none';
  }

  function save() {
    if (!editing) return;
    var text = ta.value.trim();
    if (!text) { closePopover(); return; } // empty comment = cancel
    if (editing.mode === 'edit') {
      editing.comment.text = text;
    } else {
      var r = editing.range;
      var startG = globalOffset(r.startContainer, r.startOffset);
      var endG = globalOffset(r.endContainer, r.endOffset);
      var idx = buildIndex();
      var sec = sectionFor(r.startContainer);
      var c = {
        id: newId(),
        quote: idx.text.slice(startG, endG),
        prefix: idx.text.slice(Math.max(0, startG - CTX), startG),
        suffix: idx.text.slice(endG, endG + CTX),
        sectionId: sec.id,
        sectionTitle: sec.title,
        text: text,
        anchored: true
      };
      comments.push(c);
      wrapRange(startG, endG, c.id);
      window.getSelection().removeAllRanges();
    }
    persist();
    renderPanel();
    closePopover();
  }

  btnSave.addEventListener('click', save);
  btnCancel.addEventListener('click', closePopover);
  btnDelete.addEventListener('click', function () {
    if (editing && editing.mode === 'edit') removeComment(editing.comment.id);
    closePopover();
  });
  ta.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') closePopover();
    if (ev.key === 'Enter' && (ev.metaKey || ev.ctrlKey)) save();
  });

  function removeComment(id) {
    unwrap(id);
    comments = comments.filter(function (c) { return c.id !== id; });
    persist();
    renderPanel();
  }

  function currentSelectionRange() {
    if (documents) return null;
    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0 || sel.isCollapsed) return null;
    var r = sel.getRangeAt(0);
    if (!main.contains(r.startContainer) || !main.contains(r.endContainer)) return null;
    if (!r.toString().trim()) return null;
    return r;
  }

  document.addEventListener('mouseup', function (ev) {
    if (ev.target.closest && ev.target.closest('.sel-btn, .comment-popover, .comments-panel')) return;
    setTimeout(function () {
      var r = currentSelectionRange();
      if (!r) { selBtn.style.display = 'none'; return; }
      pendingRange = r.cloneRange();
      var rect = r.getBoundingClientRect();
      placeAt(selBtn, window.scrollX + rect.right - 20, window.scrollY + rect.bottom + 8);
    }, 0);
  });
  document.addEventListener('selectionchange', function () {
    var sel = window.getSelection();
    if (!sel || sel.isCollapsed) selBtn.style.display = 'none';
  });
  // keep the browser from collapsing the selection when the button is pressed
  selBtn.addEventListener('mousedown', function (ev) { ev.preventDefault(); });
  selBtn.addEventListener('click', function () {
    if (!pendingRange) return;
    openPopover({ mode: 'create', range: pendingRange }, pendingRange.getBoundingClientRect());
    selBtn.style.display = 'none';
  });
  document.addEventListener('mousedown', function (ev) {
    if (!editing) return;
    if (ev.target.closest && ev.target.closest('.comment-popover, .sel-btn, mark.comment-mark')) return;
    closePopover();
  });

  main.addEventListener('click', function (ev) {
    var m = ev.target.closest && ev.target.closest('mark.comment-mark');
    if (!m) return;
    var id = m.getAttribute('data-cid'), c = null;
    for (var i = 0; i < comments.length; i++) if (comments[i].id === id) c = comments[i];
    if (c) openPopover({ mode: 'edit', comment: c }, m.getBoundingClientRect());
  });

  // ---- comments panel ----------------------------------------------------
  var panel = document.createElement('aside');
  panel.className = 'comments-panel';
  if (documents) panel.classList.add('open');
  var drawer = document.createElement('div');
  drawer.className = 'panel-drawer';
  var listEl = document.createElement('ol');
  listEl.className = 'panel-list';
  var foot = document.createElement('div');
  foot.className = 'panel-foot';
  var btnCopy = mkBtn('Copy for agent', 'primary');
  var btnClear = mkBtn('Clear all');
  foot.appendChild(btnClear);
  foot.appendChild(btnCopy);
  drawer.appendChild(listEl);
  drawer.appendChild(foot);
  var pill = document.createElement('button');
  pill.type = 'button';
  pill.className = 'panel-pill';
  panel.appendChild(drawer);
  panel.appendChild(pill);
  document.body.appendChild(panel);

  pill.addEventListener('click', function () { panel.classList.toggle('open'); });

  function jumpTo(c) {
    var m = main.querySelector('mark.comment-mark[data-cid="' + c.id + '"]');
    if (!m) return;
    m.scrollIntoView({ behavior: 'smooth', block: 'center' });
    m.classList.add('flash');
    setTimeout(function () { m.classList.remove('flash'); }, 1500);
  }

  function renderPanel() {
    panel.style.display = documents || comments.length ? '' : 'none';
    btnCopy.disabled = btnClear.disabled = !comments.length;
    if (!documents && !comments.length) panel.classList.remove('open');
    pill.textContent = '💬 ' + comments.length + ' comment' + (comments.length === 1 ? '' : 's');
    listEl.textContent = '';
    comments.forEach(function (c) {
      var li = document.createElement('li');
      var head = document.createElement('div');
      head.className = 'card-head';
      var chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = c.sectionTitle || 'Top';
      if (c.document) {
        var link = document.createElement('a');
        link.href = c.document.url;
        link.textContent = c.document.name;
        head.appendChild(link);
      }
      head.appendChild(chip);
      if (c.anchored === false) {
        var warn = document.createElement('span');
        warn.className = 'chip is-orphan';
        warn.textContent = 'unanchored';
        head.appendChild(warn);
      }
      var q = document.createElement('div');
      q.className = 'card-quote';
      q.textContent = '“' + excerpt(c.quote, 90) + '”';
      var t = document.createElement('div');
      t.className = 'card-text';
      t.textContent = c.text;
      var actions = document.createElement('div');
      actions.className = 'card-actions';
      if (!documents && c.anchored !== false) {
        var bJump = document.createElement('button');
        bJump.type = 'button';
        bJump.textContent = 'jump';
        bJump.addEventListener('click', function () { jumpTo(c); });
        actions.appendChild(bJump);
      }
      var bEdit = document.createElement('button');
      bEdit.type = 'button';
      bEdit.textContent = 'edit';
      bEdit.addEventListener('click', function () {
        var m = main.querySelector('mark.comment-mark[data-cid="' + c.id + '"]');
        openPopover({ mode: 'edit', comment: c }, (m || li).getBoundingClientRect());
      });
      actions.appendChild(bEdit);
      var bDel = document.createElement('button');
      bDel.type = 'button';
      bDel.className = 'danger';
      bDel.textContent = 'delete';
      bDel.addEventListener('click', function () { removeComment(c.id); });
      actions.appendChild(bDel);
      li.appendChild(head);
      li.appendChild(q);
      li.appendChild(t);
      li.appendChild(actions);
      listEl.appendChild(li);
    });
  }

  // ---- copy for agent ----------------------------------------------------
  function buildMarkdown() {
    var head = documents ? 'Apply the following review feedback to these documents:' : sourcePath
      ? 'Apply the following review feedback to the plan at ' + sourcePath + ':'
      : 'Apply the following review feedback to the plan titled "' + document.title + '":';
    var lines = [head, ''];
    comments.forEach(function (c, i) {
      if (c.document) lines.push('File: ' + c.document.source);
      var tag = '[Section: ' + (c.sectionTitle || 'Top')
        + (c.anchored === false ? ' - anchor may have moved' : '') + ']';
      lines.push((i + 1) + '. ' + tag + ' Re: "' + excerpt(c.quote, 200) + '"');
      c.text.split('\n').forEach(function (t) { lines.push('   ' + t); });
      lines.push('');
    });
    return lines.join('\n').replace(/[ \t]+\n/g, '\n').trim() + '\n';
  }

  function copyFallback(s) {
    var t = document.createElement('textarea');
    t.value = s;
    t.style.position = 'fixed';
    t.style.opacity = '0';
    document.body.appendChild(t);
    t.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(t);
    if (!ok) throw new Error('copy failed');
  }
  function copyText(s) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(s).catch(function () { copyFallback(s); });
    }
    return Promise.resolve().then(function () { copyFallback(s); });
  }
  function flashCopyBtn(label, cls) {
    btnCopy.textContent = label;
    btnCopy.classList.add(cls);
    setTimeout(function () {
      btnCopy.textContent = 'Copy for agent';
      btnCopy.classList.remove(cls);
    }, 1400);
  }
  btnCopy.addEventListener('click', function () {
    copyText(buildMarkdown()).then(function () {
      flashCopyBtn('Copied', 'done');
    }).catch(function () {
      flashCopyBtn('Copy failed', 'failed');
    });
  });
  btnClear.addEventListener('click', function () {
    if (!window.confirm('Delete all ' + comments.length + ' comments?')) return;
    comments.slice().forEach(function (c) { unwrap(c.id); });
    comments = [];
    persist();
    renderPanel();
  });

  if (!documents) comments.forEach(anchorComment);
  renderPanel();
  window.addEventListener('storage', function (event) {
    if (event.key !== null && (documents
        ? !documents.some(function (doc) { return event.key === 'plan-comments:' + doc.source; })
        : event.key !== storeKey)) return;
    comments.forEach(function (c) { unwrap(c.id); });
    closePopover();
    loadComments();
    if (!documents) comments.forEach(anchorComment);
    renderPanel();
  });

  // handle for scripting / debugging (not part of the UI)
  window.__planReview = {
    buildMarkdown: buildMarkdown,
    comments: function () { return comments; }
  };
})();
</script>

$for(include-after)$
$include-after$
$endfor$
</body>
</html>
