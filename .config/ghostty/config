macos-non-native-fullscreen = true
window-save-state = never
macos-option-as-alt = true
# add some window padding
window-padding-x = 8
window-padding-y = 6
confirm-close-surface = false
keybind = shift+enter=text:\n

font-style-italic = false
font-style-bold-italic = false
font-synthetic-style = "no-italic"
font-thicken = true
theme = dark:Catppuccin Macchiato,light:Catppuccin Latte
cursor-style = block
cursor-style-blink = false
shell-integration-features = title,path,no-cursor,ssh-terminfo,ssh-env
mouse-hide-while-typing = false
# only while the tab rendering bug exists, switch back to stable on 1.4.x
auto-update-channel = tip

window-colorspace = display-p3

# disable ligatures
font-feature = -liga
font-feature = -calt
font-feature = -dlig

config-file = ?local.config

# vim: ft=conf
