#!/usr/bin/env python3

import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")


def herdr(*args):
    result = subprocess.run(
        [HERDR, *args], check=True, stdout=subprocess.PIPE, text=True
    )
    response = json.loads(result.stdout)
    return response.get("result", response)


def state_directory():
    # Match Herdr's Unix plugin state path when invoked from an ordinary shell.
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    directory = Path(
        os.environ.get(
            "HERDR_PLUGIN_STATE_DIR", state_home / "herdr/plugins/dotfiles.last-focus"
        )
    )
    session = herdr("status", "server", "--json").get("session")
    if session and session != "default":
        directory = directory / "sessions" / session
    return directory


def load_state(path):
    try:
        state = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        state = {"workspace": {}, "tabs": {}}
    if "recent_workspaces" not in state:
        state["recent_workspaces"] = [
            workspace_id
            for workspace_id in [
                state["workspace"].get("current"),
                state["workspace"].get("previous"),
            ]
            if workspace_id
        ]
    return state


def save_state(state, path):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, sort_keys=True) + "\n")
    temporary.replace(path)


def remember(history, focused_id):
    if focused_id and history.get("current") != focused_id:
        history["previous"] = history.get("current")
        history["current"] = focused_id


def remember_workspace(state, workspace_id):
    remember(state["workspace"], workspace_id)
    state["recent_workspaces"] = [workspace_id] + [
        previous for previous in state["recent_workspaces"] if previous != workspace_id
    ]


def ordered_workspaces(state):
    workspaces = herdr("workspace", "list")["workspaces"]
    by_id = {workspace["workspace_id"]: workspace for workspace in workspaces}
    for workspace in workspaces:
        if workspace.get("focused"):
            remember_workspace(state, workspace["workspace_id"])
    state["recent_workspaces"] = [
        workspace_id
        for workspace_id in state["recent_workspaces"]
        if workspace_id in by_id
    ]
    ordered = [by_id.pop(workspace_id) for workspace_id in state["recent_workspaces"]]
    return ordered + list(by_id.values())


def bootstrap(state):
    workspaces = ordered_workspaces(state)
    for workspace in workspaces:
        workspace_id = workspace["workspace_id"]
        tab_id = workspace.get("active_tab_id")
        if tab_id:
            state["tabs"].setdefault(workspace_id, {}).setdefault("current", tab_id)


def handle_event(state):
    event = json.loads(os.environ["HERDR_PLUGIN_EVENT_JSON"])
    data = event["data"]
    if event["event"] == "workspace.focused":
        remember_workspace(state, data["workspace_id"])
    elif event["event"] == "tab.focused":
        history = state["tabs"].setdefault(data["workspace_id"], {})
        remember(history, data["tab_id"])


def switch_last_tab(state, path):
    workspaces = herdr("workspace", "list")["workspaces"]
    focused = next(
        (workspace for workspace in workspaces if workspace["focused"]), None
    )
    if not focused:
        return

    workspace_id = focused["workspace_id"]
    history = state["tabs"].setdefault(workspace_id, {})
    current = focused.get("active_tab_id")
    remember(history, current)
    target = history.get("previous")
    valid_tabs = {
        tab["tab_id"]
        for tab in herdr("tab", "list", "--workspace", workspace_id)["tabs"]
    }
    if not target or target not in valid_tabs or target == current:
        history.pop("previous", None)
        return

    history["current"], history["previous"] = target, current
    save_state(state, path)
    herdr("tab", "focus", target)


def switch_relative_tab(state, path, offset):
    workspaces = herdr("workspace", "list")["workspaces"]
    focused = next(
        (workspace for workspace in workspaces if workspace["focused"]), None
    )
    if not focused:
        return

    workspace_id = focused["workspace_id"]
    current = focused.get("active_tab_id")
    tabs = [
        tab["tab_id"]
        for tab in herdr("tab", "list", "--workspace", workspace_id)["tabs"]
    ]
    if current not in tabs or len(tabs) < 2:
        return

    target = tabs[(tabs.index(current) + offset) % len(tabs)]
    history = state["tabs"].setdefault(workspace_id, {})
    remember(history, current)
    remember(history, target)
    save_state(state, path)
    herdr("tab", "focus", target)


def switch_last_workspace(state, path):
    workspaces = herdr("workspace", "list")["workspaces"]
    focused = next(
        (workspace for workspace in workspaces if workspace["focused"]), None
    )
    if not focused:
        return

    current = focused["workspace_id"]
    history = state["workspace"]
    remember_workspace(state, current)
    target = history.get("previous")
    valid_workspaces = {workspace["workspace_id"] for workspace in workspaces}
    if not target or target not in valid_workspaces or target == current:
        history.pop("previous", None)
        return

    remember_workspace(state, target)
    save_state(state, path)
    herdr("workspace", "focus", target)


def main():
    directory = state_directory()
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / "focus-history.json"
    with (directory / "focus-history.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state(path)
        command = sys.argv[1]
        if command == "startup":
            bootstrap(state)
        elif command == "event":
            handle_event(state)
        elif command == "last-tab":
            switch_last_tab(state, path)
        elif command == "next-tab":
            switch_relative_tab(state, path, 1)
        elif command == "previous-tab":
            switch_relative_tab(state, path, -1)
        elif command == "last-workspace":
            switch_last_workspace(state, path)
        elif command == "list-workspaces":
            print(json.dumps({"result": {"workspaces": ordered_workspaces(state)}}))
        else:
            raise SystemExit(f"unknown command: {command}")
        save_state(state, path)


if __name__ == "__main__":
    main()
