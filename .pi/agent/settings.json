{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "hideThinkingBlock": true,
  "lastChangelogVersion": "10.0.0",
  "packages": [
    "git:github.com/simonrw/pi-extensions",
    "npm:csm-pi-session-monitor",
    "npm:pi-subagents",
    "npm:@ollama/pi-web-search"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-6-luna"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "scout": {
        "model": "openai-codex/gpt-6-luna"
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna"
      }
    },
    "defaultModel": "openai-codex/gpt-6-luna"
  },
  "theme": "light/dark",
  "tuiMode": "fullscreen",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0"
  }
}
